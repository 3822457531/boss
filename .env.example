# 复制为 .env 后填写。切勿把真实 Key 提交到版本库。

# —— 大模型（生成回复）——
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1600
LLM_TEMPERATURE=0.3

# —— Jev（判断，不生成文本）——
JEV_ENABLED=false
JEV_PROVIDER=typesafe
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-latest

# 兼容旧脚本
TYPESAFE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# boss CLI（可选；留空则自动探测）
BOSS_BIN=
